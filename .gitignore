# ══════════ 项目专属 ══════════

# 转录输出（每视频一个子目录 {BV号}_{标题}/）
out/
library/

# 并行开发 worktree 与本地状态
.worktree/
.backups/
.history/

# Pi Agent 运行时任务产物（会话输出/日志），其余 .pi 内容（memory 等）照常跟踪
.pi/tasks/

# 环境变量（生产环境通过环境变量注入，不落盘）
.env
.env.*.worktree/

# ══════════ Python ══════════

# 字节码缓存
__pycache__/
*.py[cod]

# 虚拟环境
.venv/

# 构建产物
dist/
build/
*.egg-info/
.eggs/
*.egg


# 注意: uv.lock 应入库（Dockerfile uv sync --frozen 依赖），勿再忽略

# 测试与覆盖率
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# 代码检查缓存
.ruff_cache/
.mypy_cache/
.cache/

# 日志
*.log

# ══════════ 操作系统 ══════════

.DS_Store
Thumbs.db

# ══════════ IDE ══════════

.vscode/
.idea/

# PyPI 发布凭据
.pypirc
